JWT_SECRET="agri-eval-super-secret-jwt-key-2026"
PORT=3001
NODE_ENV=development

# LLM Provider Configuration (groq | openai | gemini | ollama)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
# OPENAI_API_KEY=your-openai-key
# GEMINI_API_KEY=your-gemini-key
# OLLAMA_BASE_URL=http://localhost:11434

# Storage Provider Configuration (local | s3 | minio | cloudinary)
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# AWS S3 Configuration
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=your-bucket-name

# MinIO Configuration (Phase 1 default when running via docker compose)
# Set STORAGE_PROVIDER=minio above to use these.
# MINIO_ENDPOINT is the S3 API endpoint the backend talks to.
#   - inside docker compose: http://minio:9000
#   - running backend on host: http://localhost:9000
# MINIO_ENDPOINT=http://localhost:9000
# MINIO_PUBLIC_ENDPOINT is used to build browser-openable URLs (host-reachable).
# MINIO_PUBLIC_ENDPOINT=http://localhost:9000
# MinIO uses the AWS_* credentials above (root user/password by default):
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# S3_BUCKET=proposals

# Cloudinary Configuration
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# Firebase
FIREBASE_PROJECT_ID=project1-b1218
