# Backend-specific configuration — copy to backend/.env.
# Shared values (JWT_SECRET, GROQ_API_KEY, DATABASE_URL, MinIO endpoint and
# credentials) belong in the ROOT .env (see /.env.example); the backend loads
# backend/.env first and falls back to the root file for anything unset here.
# A key present in both files: backend/.env wins.

PORT=3001
NODE_ENV=development
PYTHON_SERVICE_URL=http://localhost:8000

# CORS: comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# LLM Provider (groq | openai | gemini | ollama). API keys live in the root .env.
LLM_PROVIDER=groq
# OPENAI_API_KEY=your-openai-key
# GEMINI_API_KEY=your-gemini-key
# OLLAMA_BASE_URL=http://localhost:11434

# Storage Provider (local | s3 | minio | cloudinary).
# "minio" is the default dev setup (docker compose MinIO); its endpoint and
# credentials come from the root .env.
STORAGE_PROVIDER=minio
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Cloudinary (only when STORAGE_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# PostgreSQL: DATABASE_URL comes from the root .env. Discrete parts are also
# supported as an alternative:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=agrieval
# DB_USER=agrieval
# DB_PASSWORD=your-db-password
# Pool / retry tuning (optional; sensible defaults applied):
# DB_POOL_MAX=10
# DB_CONNECT_RETRIES=5
# DB_CONNECT_RETRY_DELAY_MS=2000
