# Python Service Configuration
PORT=8000
ENV=development
LOG_LEVEL=INFO

# LLM Provider (groq)
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Document Processing
MAX_FILE_SIZE_MB=50
SUPPORTED_FORMATS=pdf,docx,doc,pptx,ppt,txt,png,jpg,jpeg,tiff,bmp
CHUNK_SIZE_TOKENS=2000
CHUNK_OVERLAP_TOKENS=200

# OCR Settings
OCR_ENABLED=true
OCR_LANGUAGE=eng
TESSERACT_CMD=/usr/bin/tesseract

# Evaluation Settings
EVALUATION_TIMEOUT_SECONDS=300
MAX_RETRIES=3

# Storage Provider: local | s3 | minio
# "local" stores files on disk under STORAGE_LOCAL_DIR
# "s3" uses AWS S3 via boto3
# "minio" uses MinIO (S3-compatible) — set S3_ENDPOINT_URL to your MinIO endpoint
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./uploads

# S3 / MinIO settings (required when STORAGE_PROVIDER=s3 or minio)
S3_BUCKET_NAME=agrieval-uploads
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1

# Database (PostgreSQL — async via asyncpg)
DATABASE_URL=postgresql+asyncpg://agrieval:agrieval123@localhost:5432/agrieval
