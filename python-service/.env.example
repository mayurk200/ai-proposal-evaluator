# Python-service-specific configuration — copy to python-service/.env.
# Shared values (GROQ_API_KEY, DATABASE_URL, MinIO endpoint and credentials)
# belong in the ROOT .env (see /.env.example); this service loads the root
# .env first, then this file — a key present in both: this file wins.

PORT=8000
ENV=development
LOG_LEVEL=INFO

# LLM tuning (provider key comes from the root .env)
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Document Processing
MAX_FILE_SIZE_MB=50
SUPPORTED_FORMATS=pdf,docx,doc,pptx,ppt,txt,png,jpg,jpeg,tiff,bmp
CHUNK_SIZE_TOKENS=2000
CHUNK_OVERLAP_TOKENS=200

# OCR Settings. Leave TESSERACT_CMD unset to auto-detect from PATH.
#   Windows install: https://github.com/UB-Mannheim/tesseract/wiki
#   then e.g. TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#   Linux/Docker: TESSERACT_CMD=/usr/bin/tesseract
OCR_ENABLED=true
OCR_LANGUAGE=eng
# TESSERACT_CMD=

# Evaluation Settings
EVALUATION_TIMEOUT_SECONDS=300
MAX_RETRIES=3

# Storage Provider: local | s3 | minio
# "local" stores files on disk under STORAGE_LOCAL_DIR
# "minio" (dev default) uses the docker compose MinIO — endpoint/credentials
#         (S3_ENDPOINT_URL, S3_ACCESS_KEY, S3_SECRET_KEY) come from the root .env
STORAGE_PROVIDER=minio
STORAGE_LOCAL_DIR=./uploads
