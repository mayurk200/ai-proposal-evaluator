# =============================================================================
# AgriEval — the ONE file you need to edit.
#
#   cp .env.example .env       (Linux/macOS)
#   copy .env.example .env     (Windows)
#
# Then run ./run.sh (Linux/macOS) or .\run.ps1 (Windows). The startup script
# derives backend/.env and python-service/.env from this file, so those two are
# generated — do not edit them by hand.
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED — the only value you must supply.
# Get one at https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=

# -----------------------------------------------------------------------------
# Operator accounts (seeded on first run).
#
# CHANGE THESE BEFORE DEPLOYING. The seed script refuses to be quiet about the
# defaults, and it should not have to.
#
#   ADMIN — resolves the duplicate gate, approves/rejects, marks funding.
#   DESK2 — uploads, processes, retries, reads everything. Cannot decide.
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@agrieval.local
ADMIN_PASSWORD=ChangeMe!Admin1
DESK2_EMAIL=desk2@agrieval.local
DESK2_PASSWORD=ChangeMe!Desk2

# Signs the JWTs. Any random string of 10+ characters; change it for a real deployment.
JWT_SECRET=change-this-to-a-long-random-string

# -----------------------------------------------------------------------------
# Groq rate limits — ACCOUNT-SPECIFIC, and the single biggest lever on speed.
#
# Groq meters (input + max_tokens) against a rolling per-minute budget, so these
# numbers decide how fast an evaluation can possibly run. The defaults below are
# Groq's FREE tier, on which one evaluation takes roughly 4 minutes — almost all
# of it spent waiting on the budget rather than on inference.
#
# Raise your tier, raise these numbers, and the same code goes several times
# faster with no other change. Read your real limits from the response headers:
#
#   curl -sD - -o /dev/null https://api.groq.com/openai/v1/chat/completions \
#     -H "Authorization: Bearer $GROQ_API_KEY" -H 'Content-Type: application/json' \
#     -d '{"model":"llama-3.3-70b-versatile","messages":[{"role":"user","content":"hi"}],"max_tokens":1}' \
#     | grep x-ratelimit-limit-tokens
#
# NOTE: the free tier also has a DAILY cap (~100k tokens on the 70B model). One
# evaluation costs ~35k, so you get roughly three per day before it stops.
# -----------------------------------------------------------------------------
LLM_TPM=12000        # llama-3.3-70b-versatile — the judgment agents
LLM_TPM_FAST=6000    # llama-3.1-8b-instant    — metadata extraction

# -----------------------------------------------------------------------------
# Ports
# -----------------------------------------------------------------------------
FRONTEND_PORT=5173
GATEWAY_PORT=3001
PYTHON_PORT=8000

# -----------------------------------------------------------------------------
# Postgres. Must be a pgvector build — the similarity gate needs the `vector`
# extension, and the stock postgres image does not have it. docker-compose.yml
# pins pgvector/pgvector:pg16 for exactly this reason.
# -----------------------------------------------------------------------------
POSTGRES_USER=agrieval
POSTGRES_PASSWORD=agrieval123
POSTGRES_DB=agrieval
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# File storage.
#   local — files on disk under python-service/uploads. Fine for development.
#   minio — S3-compatible object storage (docker-compose brings it up).
# -----------------------------------------------------------------------------
STORAGE_PROVIDER=local

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET_NAME=agrieval-uploads

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Windows: if Tesseract is not on PATH, point at it, e.g.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

LOG_LEVEL=INFO
