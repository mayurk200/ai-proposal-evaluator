# ============================================================================
# ROOT .env — single source of truth for values shared across services.
# Copy to .env and fill in the secrets. See docs/setup.md.
#
# Read by:
#   - docker-compose.yml       (variable substitution)
#   - backend                  (loaded as fallback after backend/.env)
#   - python-service           (loaded as base before python-service/.env)
# ============================================================================

# --- Secrets ---------------------------------------------------------------
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
# Any random string of 10+ characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-to-a-long-random-string

# --- PostgreSQL (Docker container "agrieval-postgres") ----------------------
# POSTGRES_* seed the container on FIRST volume init only; DATABASE_URL is what
# the apps use. Keep them in sync. If you change the password after the volume
# exists, run: scripts\dev.ps1 (self-heals) or see docs/setup.md "Password reset".
POSTGRES_USER=agrieval
POSTGRES_PASSWORD=agrieval123
POSTGRES_DB=agrieval
# The "+asyncpg" driver suffix is required by the Python service; the Node
# backend strips it automatically. Must match POSTGRES_* above.
DATABASE_URL=postgresql+asyncpg://agrieval:agrieval123@localhost:5432/agrieval

# --- MinIO (Docker container "agrieval-minio") ------------------------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
# Where services reach MinIO from the host.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
S3_ENDPOINT_URL=http://localhost:9000
# Backend credentials (AWS_* names are what the backend SDK reads). Must match
# MINIO_ROOT_USER / MINIO_ROOT_PASSWORD.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
# Python-service credential names. Must also match MINIO_ROOT_*.
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# Buckets: backend uploads land in S3_BUCKET; the Python service stores its
# artifacts in S3_BUCKET_NAME.
S3_BUCKET=proposals
S3_BUCKET_NAME=agrieval-uploads
